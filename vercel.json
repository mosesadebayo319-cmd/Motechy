{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run check",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": { "api/contact.js": { "maxDuration": 20 } },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        { "key": "X-Frame-Options", "value": "DENY" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://va.vercel-scripts.com; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://vitals.vercel-insights.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/index", "destination": "/", "permanent": true },
    { "source": "/blog/index", "destination": "/blog", "permanent": true },
    {
      "source": "/7-day-content-starter",
      "destination": "/blog/7-day-content-starter",
      "permanent": true
    },
    {
      "source": "/content-strategy-problem",
      "destination": "/blog/content-strategy-problem",
      "permanent": true
    },
    {
      "source": "/signal-vs-noise",
      "destination": "/blog/signal-vs-noise",
      "permanent": true
    },
    {
      "source": "/systems-beat-hacks",
      "destination": "/blog/systems-beat-hacks",
      "permanent": true
    },
    {
      "source": "/consistency-creates-momentum",
      "destination": "/blog/consistency-creates-momentum",
      "permanent": true
    }
  ]
}
